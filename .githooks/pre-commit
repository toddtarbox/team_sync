#!/usr/bin/env bash
# Pre-commit hook: scan staged files for common secret patterns and block commit if found.
# NOTE: Patterns are composed at runtime (not hard-coded) to avoid the hook flagging its own
# source file or the CI scanner. Files under .githooks/ and scripts/ci/ are excluded by default.
set -euo pipefail

# Build patterns at runtime (avoid including full literal patterns in source)
AI_P1='A'
AI_P2='I'
AI_P3='za'
PAT_AI="${AI_P1}${AI_P2}${AI_P3}[0-9A-Za-z_-]{10,}"

PK_B1='-----BEGIN '
PK_B2='PRIVATE'
PK_B3=' KEY-----'
PAT_PK="${PK_B1}${PK_B2}${PK_B3}"

RSA_B1='-----BEGIN RSA '
RSA_B2='PRIVATE KEY-----'
PAT_RSA="${RSA_B1}${RSA_B2}"

AK1='AK'
AK2='IA'
PAT_AK="${AK1}${AK2}[0-9A-Z]{8,}"

AWS_A='aws_'
AWS_B='secret_access_key'
PAT_AWS="${AWS_A}${AWS_B}"

XOX1='xox'
XOX2='[baprs]-'
PAT_XOX="${XOX1}${XOX2}"

CLIENT1='client'
CLIENT2='_secret'
PAT_CLIENT="${CLIENT1}${CLIENT2}"

PAT_PRIVKEY='PRIVATE_KEY='

# Compose final patterns array
PATTERNS=(
  "${PAT_AI}"
  "${PAT_PK}"
  "${PAT_RSA}"
  "${PAT_AK}"
  "${PAT_AWS}"
  "${PAT_XOX}"
  "${PAT_CLIENT}"
  "${PAT_PRIVKEY}"
)

# Ensure there are staged changes
if git diff --cached --quiet; then
  # nothing staged
  exit 0
fi

FOUND=0

echo "[pre-commit] scanning staged changes for secrets..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

# Exclude the hook and CI directories (they may contain the patterns as literals)
# Add paths here if you intentionally include pattern strings that would otherwise be flagged.
# Excluding .githooks/ and scripts/ci/ prevents self-detection while still scanning all other
# code and assets. If you add pattern strings to other files, add them to this regex.
EXCLUDE_RE='(^\.githooks/|^scripts/ci/|^\.github/|^\.gitleaksignore$)'

# Filter files to scan
FILES_TO_SCAN=$(echo "$STAGED_FILES" | grep -Ev "$EXCLUDE_RE" || true)
if [ -z "$FILES_TO_SCAN" ]; then
  echo "[pre-commit] no staged files to scan after applying exclude patterns"
  exit 0
fi

# Build the staged diff limited to the filtered files
# Instead of grepping the whole combined diff (which doesn't show filenames reliably),
# inspect each staged file's diff individually so we can report the filename with matches.
FOUND=0

while IFS= read -r file; do
  # Skip empty lines (safety)
  [ -z "$file" ] && continue
  # Get the staged diff for this file only
  FILE_DIFF=$(git diff --cached -U0 --no-color -- "$file" 2>/dev/null || true)
  if [ -z "$FILE_DIFF" ]; then
    continue
  fi

  # Parse the per-file diff to compute new-file line numbers for added lines.
  # We'll walk the diff line-by-line, update a 'newLine' pointer from hunk headers
  # like: @@ -oldStart,oldCount +newStart,newCount @@ and check only added lines ('+').
  newLine=0
  while IFS= read -r diffLine; do
    # Hunk header
    if [[ "$diffLine" =~ ^@@[[:space:]]+-[0-9]+(,[0-9]+)?[[:space:]]+\+([0-9]+)(,([0-9]+))?[[:space:]]+@@ ]]; then
      newLine=${BASH_REMATCH[2]}
      # Continue to next line after header
      continue
    fi

    firstChar="${diffLine:0:1}"
    # Only consider added lines (start with '+') for new-file locations
    if [[ "$firstChar" == '+' ]]; then
      # Strip the leading '+' to get the actual content
      lineContent="${diffLine:1}"
      # Check each pattern against the added line content
      for pat in "${PATTERNS[@]}"; do
        if echo "$lineContent" | grep -E --quiet -- "$pat" 2>/dev/null; then
          echo "Potential secret pattern detected in file: $file (pattern: $pat)"
          # Show the file path and computed new-file line number; do NOT print the matching content to avoid leaking secrets
          echo "$file:${newLine}: [MATCH] (content hidden for security)"
          FOUND=1
        fi
      done
      # advance new-file line counter for added line
      newLine=$((newLine + 1))
    elif [[ "$firstChar" == ' ' ]]; then
      # Context line -> advances new-file line number as well
      newLine=$((newLine + 1))
    else
      # Removed lines ('-') do not advance new-file line counter
      :
    fi
  done <<< "$FILE_DIFF"

done <<< "$FILES_TO_SCAN"

if [ $FOUND -ne 0 ]; then
  echo
  echo "ERROR: Possible secrets detected in staged files. Commit aborted." >&2
  echo "  - Remove secrets from the files, put them in a local .env (gitignored), and/or unstage them." >&2
  echo "  - To bypass temporarily: git reset <file> && add the safe replacement then commit." >&2
  exit 1
fi

# Run flutter analyze on staged Dart files (if any) and if flutter is available
STAGED_DART_FILES=$(echo "$FILES_TO_SCAN" | grep -E '\.dart$' || true)
if [ -n "$STAGED_DART_FILES" ]; then
  if command -v flutter >/dev/null 2>&1; then
    echo "[pre-commit] running flutter analyze on staged Dart files..."
    # Read into array to preserve filenames with spaces
    # Run flutter analyze on the whole project (do not pass file arguments)
    if ! flutter analyze; then
      echo
      echo "ERROR: flutter analyze failed. Fix analyzer issues before committing." >&2
      exit 1
    fi
  else
    echo "[pre-commit] flutter not found in PATH; skipping flutter analyze"
  fi
fi

# No secrets found
exit 0
