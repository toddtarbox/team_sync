{
  "rules": {
    "database_access": {
      "$ownerId": {
        ".read": "$ownerId === auth.uid",
        ".write": "$ownerId === auth.uid",
        ".indexOn": ["email"]
      }
    },
    "user_database_access": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": false
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "$userId === auth.uid"
      },
      ".indexOn": ["email"]
    },
    "subscriptionIds": {
      "$uid": {
        "databases": {
          ".read": "auth != null && auth.uid == $uid",
          "$db": {
            ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists() || (auth != null && (auth.uid == $uid || root.child('user_database_access').child(auth.uid).child($uid).child($db).exists()))",
            ".write": "auth != null && (auth.uid == $uid || root.child('user_database_access').child(auth.uid).child($uid).child($db).child('accessLevel').val() == 'write')",
            "Teams": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()",
              ".indexOn": ["id"]
            },
            "Players": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()",
              ".indexOn": ["id", "teamId", "seasonId", "teamId_seasonId", "id_seasonId"]
            },
            "Games": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()",
              ".indexOn": ["id", "seasonId", "homeTeamId", "awayTeamId"]
            },
            "Events": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()",
              ".indexOn": ["id", "gameId", "teamId", "seasonId", "teamId_seasonId", "playerId"]
            },
            "Seasons": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()",
              ".indexOn": ["id", "teamId"]
            },
            "GameEvents": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()"
            },
            "PlayerAwards": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()"
            },
            "PlayerStats": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()"
            },
            "TeamStats": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()"
            },
            "Settings": {
              ".read": "root.child('subscriptionIds').child($uid).child('databases').child($db).child('publicShareId').exists()"
            },
            "_backups": {
              "$backup_ts": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": "auth != null && auth.uid == $uid"
              }
            }
          }
        }
      }
    },
    "shared_databases": {
      ".read": true,
      ".write": "auth != null",
      "$publicId": {
        ".validate": "newData.hasChildren(['databasePath']) && newData.child('databasePath').isString()"
      }
    }
  }
}