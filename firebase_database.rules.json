{
  "rules": {
    "subscriptionIds": {
      "$uid": {
        "databases": {
          ".read": "auth != null && auth.uid == $uid",
          "$db": {
            "Teams": {
              ".indexOn": ["id"]
            },
            "Players": {
              ".indexOn": ["id", "teamId", "seasonId"]
            },
            "Games": {
              ".indexOn": ["id", "seasonId", "homeTeamId", "awayTeamId"]
            },
            "Events": {
              ".indexOn": ["id", "gameId", "teamId", "seasonId"]
            },
            "Seasons": {
              ".indexOn": ["id", "teamId"]
            },
            "_backups": {
              "$backup_ts": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": "auth != null && auth.uid == $uid"
              }
            },
            ".read": "(auth != null && auth.uid == $uid) || (data.child('publicShareId').val() != null)",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },

    "shared_databases": {
      ".read": true,
      ".write": "auth != null",
      "$publicId": {
        ".validate": "newData.hasChildren(['databasePath']) && newData.child('databasePath').isString()"
      }
    },

    "Clubs": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'ttarbox0603@gmail.com'",
      ".indexOn": ["id"],
      "$clubId": {
        ".validate": "newData.hasChildren(['id', 'name', 'createdAt'])"
      }
    },
    "ClubTeams": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["clubId", "id"]
    },
    "ClubSeasons": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["clubId", "teamId"]
    },
    "ClubGames": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["clubId", "seasonId"]
    },
    "ClubPlayers": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["clubId", "teamId"]
    },
    "ClubEvents": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["clubId", "gameId"]
    }
  }
}
